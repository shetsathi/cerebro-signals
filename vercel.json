{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "env": {
    "SUPABASE_URL": "@supabase_url",
    "SUPABASE_ANON_KEY": "@supabase_anon_key"
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "src": "/dashboard/(.*)",
      "dest": "/public/dashboard/index.html"
    },
    {
      "src": "/",
      "dest": "/public/dashboard/index.html"
    }
  ]
}
