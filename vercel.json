{
  "version": 2,
  "buildCommand": "npm run build && cp -r public/* dist/public/",
  "outputDirectory": "dist",
  "env": {
    "SUPABASE_URL": "@supabase_url",
    "SUPABASE_ANON_KEY": "@supabase_anon_key"
  },
  "functions": {
    "src/api/server.ts": {
      "runtime": "@vercel/node@latest",
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/src/api/server.ts"
    }
  ]
}
